.DS_Store

# Ignore temporary files, but keep the contest template files
/contest_env/.CP/*

!/contest_env/.CP/contest_files
!/contest_env/.CP/contest_files/*

!/contest_env/.CP/contest_templates
!/contest_env/.CP/contest_templates/*

# zsh plugin files
/zsh/.config/zsh/plugins/*
# zsh history
/zsh/.config/zsh/.zsh_history
