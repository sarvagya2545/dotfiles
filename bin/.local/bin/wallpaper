#!/usr/bin/env bash
#
# wallpaper.sh — pick a wallpaper with fzf, preview it, then apply it to
#                every Space currently present.
#
# Two preview strategies:
#   Outside tmux — chafa straight into fzf's preview pane.
#   Inside tmux  — a real tmux pane beside fzf, repainted with
#                  `tmux respawn-pane` on every selection change. tmux
#                  decodes the sixel into that pane's own grid, which is
#                  the one path verified to work. fzf never touches the
#                  image bytes.
#
# Deps:  fzf (any version), chafa
#
# Usage:   ./wallpaper.sh
#          ./wallpaper.sh --doctor
#          WALLPAPER_DIR=~/Pictures/walls ./wallpaper.sh
#
set -euo pipefail

SCRIPT_VERSION=11

WALLPAPER_DIR="${WALLPAPER_DIR:-$HOME/Downloads/wallpapers}"
PREVIEW_WIDTH="${PREVIEW_WIDTH:-55}"     # percent of the window
THUMB_SIZE="${THUMB_SIZE:-1200}"

# Fixed path on purpose. $TMPDIR on macOS is a long per-user directory
# under /var/folders, which is a bad place to go looking for a log.
WALLPAPER_LOG="${WALLPAPER_LOG:-/tmp/wallpaper-debug.log}"

# One format everywhere. WezTerm draws sixel whether or not tmux is in the
# picture, so the inline preview and the tmux pane use the same command.
# Set PREVIEW_FORMAT=iterm for sharper colour outside tmux; it is a full
# PNG rather than sixel's limited palette, and a smaller payload.
PREVIEW_FORMAT="${PREVIEW_FORMAT:-sixel}"


chafa_render() {
    # chafa_render FILE COLSxLINES
    chafa -f "$PREVIEW_FORMAT" --passthrough none --exact-size on \
          --animate off -s "$2" "$1"
}

# ----------------------------------------------------------------------
# Orientation-correct thumbnails.
# WezTerm renders raw pixels and ignores the EXIF Orientation tag.
# qlmanage bakes the rotation in the way Finder shows it.
# ----------------------------------------------------------------------
normalize() {
    local img="$1"
    local cache_dir="${TMPDIR:-/tmp}/wallpaper-preview"
    mkdir -p "$cache_dir"
    local key mtime norm
    key="$(printf '%s' "$img" | shasum | cut -d' ' -f1)"
    mtime="$(stat -f %m "$img" 2>/dev/null || echo 0)"
    norm="$cache_dir/${key}-${mtime}-${THUMB_SIZE}.png"
    if [[ ! -f "$norm" ]]; then
        if qlmanage -t -s "$THUMB_SIZE" -o "$cache_dir" "$img" >/dev/null 2>&1 \
           && [[ -f "$cache_dir/$(basename "$img").png" ]]; then
            mv -f "$cache_dir/$(basename "$img").png" "$norm"
        else
            norm="$img"
        fi
    fi
    printf '%s\n' "$norm"
}

# ----------------------------------------------------------------------
# Callback: repaint the dedicated tmux preview pane.
#   wallpaper.sh --pane-preview %PANE_ID FILE
# ----------------------------------------------------------------------
if [[ "${1:-}" == "--pane-preview" ]]; then
    pane="$2"; img="$3"

    # Debug: WALLPAPER_DEBUG=1 sends every callback's trace here. Errors in
    # an execute-silent binding are invisible otherwise, which is exactly
    # how the previous version failed without a word.
    if [[ -n "${WALLPAPER_DEBUG:-}" ]]; then
        exec 2>>"$WALLPAPER_LOG"
        echo "--- pane-preview $(date '+%H:%M:%S') pane=$pane img=$img" >&2
        set -x
    fi

    # Pane geometry. `display -p -t` accepts a pane id; this doubles as the
    # liveness check, since it fails if the pane is gone.
    if ! geo="$(tmux display -p -t "$pane" '#{pane_width} #{pane_height}' 2>/dev/null)"; then
        exit 0
    fi
    read -r w h <<< "$geo"
    [[ "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] || exit 0
    (( h > 1 )) && h=$(( h - 1 ))

    # Absolute path: the preview pane has its own working directory, so a
    # relative name from fzf would not resolve over there.
    case "$img" in
        /*) : ;;
        *)  img="$WALLPAPER_DIR/$img" ;;
    esac
    norm="$(normalize "$img")"
    case "$norm" in
        /*) : ;;
        *)  norm="$PWD/$norm" ;;
    esac

    # The trailing sleep keeps the pane alive after chafa finishes, so the
    # pane (and the image in its grid) stays put until the next repaint.
    tmux respawn-pane -k -t "$pane" \
        "chafa -f $PREVIEW_FORMAT --passthrough none --exact-size on --animate off -s ${w}x${h} $(printf '%q' "$norm"); exec sleep 86400"

    # Caption on stdout. When this runs as fzf's --preview command, fzf
    # shows this text; the picture itself lives in the pane above.
    dims="$(sips -g pixelWidth -g pixelHeight "$img" 2>/dev/null \
            | awk '/pixelWidth/{w=$2} /pixelHeight/{h=$2} END{if (w) print w"x"h}')"
    bytes="$(du -h "$img" 2>/dev/null | cut -f1 | tr -d ' ')"
    printf '%s\n' "$(basename "$img")"
    [[ -n "$dims" || -n "$bytes" ]] && printf '%s  %s\n' "${dims:-?}" "${bytes:-?}"
    exit 0
fi

# ----------------------------------------------------------------------
# Callback: inline preview for the no-tmux case.
# ----------------------------------------------------------------------
if [[ "${1:-}" == "--preview" ]]; then
    norm="$(normalize "$2")"
    chafa_render "$norm" "${FZF_PREVIEW_COLUMNS:-80}x${FZF_PREVIEW_LINES:-25}"
    exit 0
fi

# ----------------------------------------------------------------------
# Doctor
# ----------------------------------------------------------------------
if [[ "${1:-}" == "--doctor" ]]; then
    echo "script version  : $SCRIPT_VERSION  ($0)"
    echo "TERM            : ${TERM:-<unset>}"
    echo "Inside tmux     : $([[ -n "${TMUX:-}" ]] && echo yes || echo no)"
    echo "fzf             : $(fzf --version 2>/dev/null || echo MISSING)"
    if printf 'x\n' | fzf --filter=x --bind 'focus:execute-silent(true)' >/dev/null 2>&1; then
        echo "fzf focus event : supported"
    else
        echo "fzf focus event : NOT supported (needs fzf 0.36+)"
    fi
    echo "preview format  : $PREVIEW_FORMAT"
    echo "debug log path  : $WALLPAPER_LOG"
    echo "chafa           : $(chafa --version 2>/dev/null | head -1 || echo MISSING)"
    if [[ -n "${TMUX:-}" ]]; then
        echo "tmux version    : $(tmux -V)"
        echo "client features : $(tmux display -p '#{client_termfeatures}' 2>/dev/null || echo '<unknown>')"
        ibs="$(tmux show -gv input-buffer-size 2>/dev/null || echo 0)"
        echo "input-buffer-size: $ibs"
        if [[ "$ibs" =~ ^[0-9]+$ ]] && (( ibs < 4194304 )); then
            echo "  ^ too small. A sixel image arrives as one DCS sequence, and"
            echo "    tmux silently discards any that exceed this buffer. Larger"
            echo "    images will simply not appear. Fix with:"
            echo "      tmux set -g input-buffer-size 16777216"
            echo "    and add the same line to your tmux.conf."
        fi
        echo
        echo "Preview strategy: dedicated tmux pane (respawn-pane + chafa)"
    else
        echo
        echo "Preview strategy: inline chafa in fzf's preview pane"
    fi
    exit 0
fi

# ----------------------------------------------------------------------
# Dependency checks
# ----------------------------------------------------------------------
for dep in fzf chafa qlmanage osascript; do
    command -v "$dep" >/dev/null 2>&1 || { echo "Missing dependency: $dep" >&2; exit 1; }
done
[[ -d "$WALLPAPER_DIR" ]] || { echo "No such directory: $WALLPAPER_DIR" >&2; exit 1; }

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# ----------------------------------------------------------------------
# Pick a wallpaper
# ----------------------------------------------------------------------
cd "$WALLPAPER_DIR"

list_images() {
    find . -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
           -o -iname '*.heic' -o -iname '*.gif' -o -iname '*.webp' \) \
        | sed 's|^\./||' | sort
}

PREVIEW_PANE=""
cleanup_pane() {
    [[ -n "$PREVIEW_PANE" ]] && tmux kill-pane -t "$PREVIEW_PANE" 2>/dev/null || true
    PREVIEW_PANE=""
}
trap cleanup_pane EXIT

if [[ -n "${TMUX:-}" ]]; then
    # -d keeps focus on the fzf pane; the new pane just sits there and waits.
    PREVIEW_PANE="$(tmux split-window -h -d -l "${PREVIEW_WIDTH}%" \
                        -P -F '#{pane_id}' "sleep 86400")"
    # fzf's stderr is captured too. A binding fzf does not understand makes
    # it exit immediately with a message that would otherwise scroll past.
    # --preview drives the repaint. Every fzf version runs the preview
    # command on selection change, so this needs no modern event bindings.
    fzf_err="$(mktemp)"
    selected="$(
        list_images | fzf --prompt='wallpaper > ' --cycle \
            --preview="$(printf '%q' "$SELF") --pane-preview $PREVIEW_PANE {}" \
            --preview-window='down:2:noborder' \
            2>"$fzf_err"
    )" || true
    if [[ -s "$fzf_err" ]]; then
        echo "fzf reported:" >&2
        cat "$fzf_err" >&2
        [[ -n "${WALLPAPER_DEBUG:-}" ]] && cat "$fzf_err" >>"$WALLPAPER_LOG"
    fi
    rm -f "$fzf_err"
    cleanup_pane
else
    selected="$(
        list_images | fzf --prompt='wallpaper > ' --cycle \
            --preview="$(printf '%q' "$SELF") --preview $(printf '%q' "$WALLPAPER_DIR")/{}" \
            --preview-window="right:${PREVIEW_WIDTH}%"
    )" || true
fi

[[ -z "$selected" ]] && { echo "Nothing selected."; exit 0; }

abs="$WALLPAPER_DIR/$selected"
[[ -f "$abs" ]] || { echo "File vanished: $abs" >&2; exit 1; }

# ----------------------------------------------------------------------
# Confirm before applying to every Space.
# Straight to the current pane, which is the case that already works.
# ----------------------------------------------------------------------
norm="$(normalize "$abs")"
printf '\n'
chafa_render "$norm" 60x20 || true
printf '\n'
printf 'Set "%s" as the wallpaper on EVERY Space?\n' "$selected"
read -r -p "[y/N] " reply < /dev/tty || reply=""
case "$reply" in
    [yY]|[yY][eE][sS]) ;;
    *) echo "Cancelled. Wallpaper unchanged."; exit 0 ;;
esac

# ----------------------------------------------------------------------
# Apply to every Space (SIP-safe, no DB edits)
# ----------------------------------------------------------------------
detect_spaces() {
    if command -v yabai >/dev/null 2>&1; then
        local n
        n="$(yabai -m query --spaces 2>/dev/null | grep -c '"index"')"
        [[ "$n" =~ ^[0-9]+$ ]] && (( n > 0 )) && { echo "$n"; return; }
    fi
    defaults read com.apple.spaces 2>/dev/null | grep -c "ManagedSpaceID"
}

SPACES="${SPACES:-$(detect_spaces)}"
[[ "$SPACES" =~ ^[0-9]+$ ]] && (( SPACES >= 1 )) || SPACES=1

set_visible_desktop() {
    osascript -e "tell application \"System Events\" to tell every desktop to set picture to \"$abs\"" 2>/dev/null || true
}
space_left()  { osascript -e 'tell application "System Events" to key code 123 using control down'; }
space_right() { osascript -e 'tell application "System Events" to key code 124 using control down'; }

for (( i = 0; i < SPACES; i++ )); do space_left; sleep 0.35; done

for (( i = 0; i < SPACES; i++ )); do
    set_visible_desktop
    sleep 0.2
    if (( i < SPACES - 1 )); then space_right; sleep 0.5; fi
done

echo "✓ Wallpaper set on $SPACES space(s): $abs"
